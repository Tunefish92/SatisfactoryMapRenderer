<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RootNamespace>SatisfactoryMapRenderer</RootNamespace>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- Reading the installed game (map texture, icons, level data) -->
    <PackageReference Include="CUE4Parse" Version="1.2.2.202609" />
    <PackageReference Include="AssetRipper.TextureDecoder" Version="2.6.2" />
    <!-- CUE4Parse pulls 9.0.0, which has a known vulnerability (GHSA-73j8-2gch-69rq) -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" LogicalName="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
