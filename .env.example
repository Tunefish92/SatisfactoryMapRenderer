# Copy to .env and adjust. The admin password goes into admin.env (see admin.env.example).

# Port the map is served on.
SMR_PORT=8080

# Where the rendered map, game data and settings are kept on the host.
SMR_DATA_HOST_PATH=./map-data

# Highest rendered zoom level (3-9).
SMR_MAX_ZOOM=9

# Owner of the data folder; the app runs as this user.
PUID=1000
PGID=1000
