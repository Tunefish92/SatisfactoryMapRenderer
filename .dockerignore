# Build output (rebuilt inside the image)
**/bin/
**/obj/
**/TestResults/

# Local map images, rendered maps and secrets: never part of the build context or the image
maps/
output/
map-data/
**/*_map/
**/*.sav
.env
.env.*
admin.env
admin.env.example

# Not needed to build the image
.git/
.github/
**/.vs/
**/.vscode/
**/*.user
tests/
unraid/
docs/
docker-compose*.yml
*.md
!CHANGELOG.md
.gitignore
.dockerignore
LICENSE
.gitattributes
